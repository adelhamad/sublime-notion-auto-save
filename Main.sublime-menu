[
    {
        "id": "file",
        "children": [
            { "caption": "Save to Notion", "command": "notion_save" }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "id": "package-settings",
                "children": [
                    {
                        "caption": "NotionSave",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": { "base_file": "${packages}/NotionSave/NotionSave.sublime-settings" }
                            },
                            { "caption": "Retry Uploads", "command": "notion_retry_uploads" },
                            { "caption": "Recover Pending Upload", "command": "notion_recover_upload" },
                            { "caption": "Open Queue Folder", "command": "notion_open_queue" }
                        ]
                    }
                ]
            }
        ]
    }
]
